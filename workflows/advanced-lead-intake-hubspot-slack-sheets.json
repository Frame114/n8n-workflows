            "index": 0
          }
        ]
      ]
    },
    "Build CRM Result": {
      "main": [
        [
          {
            "node": "Slack — Notify Sales",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Slack — Notify Sales": {
      "main": [
        [
          {
            "node": "Build Audit Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Audit Row": {
      "main": [
        [
          {
            "node": "Google Sheets — Append Lead Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Sheets — Append Lead Log": {

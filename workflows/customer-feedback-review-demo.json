{
  "name": "Customer Feedback and Review Eligibility (Demo)",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "portfolio/customer-feedback-review",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "demo11",
      "name": "Receive request",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "demo1"
    },
    {
      "parameters": {
        "jsCode": "const x=$json.body??$json; const email=String(x.email??'').trim().toLowerCase(); const rating=Number(x.rating); const validEmail=email.includes('@')&&email.includes('.'); const eligible=x.job_status==='completed'&&x.review_request_consent===true&&validEmail&&Number.isInteger(rating)&&rating>=1&&rating<=5; return [{json:{eligible,reason:eligible?'eligible':'job_or_consent_or_contact_or_rating_check_failed',customer_email:email,job_reference:String(x.job_reference??''),rating:Number.isInteger(rating)?rating:null,action:eligible?'Prepare neutral feedback request for human review':'Do not send request',send_automatically:false}}];"
      },
      "id": "demo12",
      "name": "Process and validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "demo13",
      "name": "Return review payload",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        760,
        300
      ]
    }
  ],
  "connections": {
    "Receive request": {
      "main": [
        [
          {
            "node": "Process and validate",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Process and validate": {
      "main": [
        [
          {
            "node": "Return review payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Europe/London"
  },
  "active": false
}
